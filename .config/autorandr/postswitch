#!/usr/bin/env bash
# autorandr postswitch hook - Sets DPI based on active display profile
#
# Profile naming convention: <type>-<machine>
#   monitors-meridian, monitors-eyenix  (96 DPI / 1.0x)
#   tv-meridian, tv-eyenix              (192 DPI / 2.0x)

case "$AUTORANDR_CURRENT_PROFILE" in
    monitors*|docked*|home*)
        DPI=96
        ;;
    tv*)
        DPI=192
        ;;
    *)
        # Default fallback for unknown profiles
        DPI=96
        ;;
esac

# Update Xft.dpi in X resources
echo "Xft.dpi: $DPI" | xrdb -merge

# Restart AwesomeWM to pick up new DPI for widgets and bars
echo "awesome.restart()" | awesome-client 2>/dev/null || true

# NVIDIA: enable ForceFullCompositionPipeline on TV profiles to eliminate
# screen tearing during fullscreen gaming on X11. Adds ~1 frame of latency,
# acceptable for cinematic/single-player gaming on the LG TV.
# Uses nvidia-auto-select so FCP applies at whatever rate autorandr negotiated
# (4K@120 when the HDMI 2.1 link is healthy; falls back to 4K@60 otherwise).
if [[ "$AUTORANDR_CURRENT_PROFILE" == tv-* ]] && command -v nvidia-settings >/dev/null; then
    nvidia-settings --assign CurrentMetaMode="HDMI-0: nvidia-auto-select +0+0 {ForceFullCompositionPipeline=On}" >/dev/null 2>&1 || true
fi

# Log the change for debugging
logger "autorandr postswitch: Profile '$AUTORANDR_CURRENT_PROFILE' - Set DPI to $DPI"
